{
  "info": {
    "name": "Healthcare Appointment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "patient_user_id", "value": "" }
  ],
  "item": [
    {
      "name": "1 Auth",
      "item": [
        {
          "name": "Register patient",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('token', pm.response.json().data.token); }"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Patient\",\n  \"email\": \"newpatient@test.com\",\n  \"password\": \"secret123\",\n  \"role\": \"patient\",\n  \"phone\": \"9333333333\",\n  \"gender\": \"male\"\n}" } }
        },
        {
          "name": "Register doctor",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('token', pm.response.json().data.token); }"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dr. Sam\",\n  \"email\": \"sam@clinic.test\",\n  \"password\": \"secret123\",\n  \"role\": \"doctor\",\n  \"phone\": \"9000000050\",\n  \"specialization\": \"ENT\"\n}" } }
        },
        {
          "name": "Login patient (patient1)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient1@gmail.com\",\n  \"password\": \"password\"\n}" } }
        },
        {
          "name": "Login patient (patient2)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient2@gmail.com\",\n  \"password\": \"password\"\n}" } }
        },
        {
          "name": "Login doctor (Dr. Arun)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"arun@gmail.com\",\n  \"password\": \"password\"\n}" } }
        },
        { "name": "Me", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/auth/me" } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/auth/logout" } }
      ]
    },
    {
      "name": "2 Browse (any logged-in user)",
      "item": [
        { "name": "List doctors", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/doctors" } },
        { "name": "Doctor details", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/doctors/1" } },
        { "name": "Doctor availability", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/doctors/1/availability?date=2026-11-23&slot_minutes=30", "host": ["{{base_url}}"], "path": ["doctors", "1", "availability"], "query": [{ "key": "date", "value": "2026-11-23" }, { "key": "slot_minutes", "value": "30" }] } } },
        { "name": "List services of doctor 1", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/services?doctor_id=1", "host": ["{{base_url}}"], "path": ["services"], "query": [{ "key": "doctor_id", "value": "1" }] } } }
      ]
    },
    {
      "name": "3 Patient",
      "item": [
        { "name": "My profile", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var response = pm.response.json(); if (response.data && response.data.user_id) pm.collectionVariables.set('patient_user_id', String(response.data.user_id));"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/patient/profile" } },
        { "name": "Update profile", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/patient/profile", "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{patient_user_id}}\",\n  \"address\": \"Chennai\",\n  \"date_of_birth\": \"1998-05-10\"\n}" } }, "description": "Run My profile first to populate patient_user_id. The ID must match the logged-in patient." },
        { "name": "Book appointment", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/appointments", "body": { "mode": "raw", "raw": "{\n  \"doctor_id\": 1,\n  \"service_id\": 1,\n  \"appointment_date\": \"2026-11-23\",\n  \"start_time\": \"10:00\",\n  \"notes\": \"First visit\"\n}" } } },
        { "name": "My appointments", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/appointments" } },
        { "name": "Reschedule appointment", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/appointments/1", "body": { "mode": "raw", "raw": "{\n  \"appointment_date\": \"2026-11-24\",\n  \"start_time\": \"11:00\"\n}" } } },
        { "name": "Cancel appointment", "request": { "method": "PATCH", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/appointments/1/cancel", "body": { "mode": "raw", "raw": "{\n  \"cancel_reason\": \"Patient request\"\n}" } } }
      ]
    },
    {
      "name": "4 Doctor",
      "item": [
        { "name": "My profile", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/doctor/profile" } },
        { "name": "My patients", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/doctor/patients" } },
        { "name": "My appointments", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/appointments" } },
        { "name": "Complete appointment", "request": { "method": "PATCH", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/appointments/1/complete" } },
        { "name": "Set working hours", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/doctor/schedules", "body": { "mode": "raw", "raw": "{\n  \"schedules\": [\n    { \"day_of_week\": 1, \"start_time\": \"09:00\", \"end_time\": \"17:00\" },\n    { \"day_of_week\": 2, \"start_time\": \"09:00\", \"end_time\": \"17:00\" }\n  ]\n}" } } },
        { "name": "Create service", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/services", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Health Checkup\",\n  \"price\": 800,\n  \"duration_minutes\": 45\n}" } } }
      ]
    }
  ]
}
